<?xml version="1.0" encoding="utf-8"?>
<!--
  Artifact configuration to paste into the SignPath project.
  The release workflow uploads the exe as a GitHub artifact, which GitHub
  stores as a zip, so the root element is <zip-file>.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="deadlock-launcher-lite.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
